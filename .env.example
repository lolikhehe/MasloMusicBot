# Copy to .env and fill in real values. .env must never be committed.

# ---- Required ----
# Token from @BotFather
TELOXIDE_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Credentials from https://my.telegram.org (only needed for the bundled local Bot API server)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# ---- Access control ----
# Comma-separated numeric Telegram user IDs that may run /stats, /ban, /unban, /purge
ADMINS=
# Chat that stores uploaded files so inline-mode editMessageMedia can reuse file_id.
# The bot must be a member (and uploader) there. Leave empty to keep inline results uncached.
# STORAGE_CHAT_ID=-1001234567890

# ---- Providers ----
# Comma-separated list, or "all". Disable anything you are not allowed to download from.
ENABLED_PROVIDERS=youtube,youtube_music,soundcloud,bandcamp,spotify,apple_music,deezer
SEARCH_PROVIDERS=youtube

# ---- Limits ----
MAX_DURATION_SECS=1200
# Audio is effectively capped at 49 MB on the cloud Bot API (50 MB upload
# limit) and at 2 GB behind the local Bot API server; MAX_FILE_MB is clamped
# to the active mode's ceiling even if set higher.
MAX_FILE_MB=49
# Collection (album/playlist) cap, default per spec is 25
MAX_COLLECTION_TRACKS=25
# Per-user cap on concurrently active downloads
MAX_ACTIVE_DOWNLOADS_PER_USER=2
RATE_LIMIT_PER_MIN=10
MAX_CONCURRENT_DOWNLOADS=4

# ---- Interface ----
DEFAULT_LANG=en
# JSON logs for production log stacks
# LOG_FORMAT=json
LOG_LEVEL=info

# ---- Lyrics (public APIs, no token, no scraping) ----
# LRCLIB_BASE_URL=https://lrclib.net
# LYRICS_OVH_BASE_URL=https://api.lyrics.ovh/v1

# ---- Horizontal scaling (experimental v2.1) ----
# Postgres DSN. Docker compose starts a postgres service and sets this by default.
DATABASE_URL=postgresql://musicbot:devpass@postgres:5432/musicbot
POSTGRES_PASSWORD=devpass
# Leave WEBHOOK_URL unset for long polling. In webhook mode set the public
# HTTPS URL (port 443/80/88/8443) that proxies to WEBHOOK_ADDR.
# WEBHOOK_URL=https://music.example.com/telegram/webhook
# WEBHOOK_SECRET=replace-with-a-random-32-char-token
# WEBHOOK_ADDR=0.0.0.0:8080
# WEBHOOK_MAX_CONNECTIONS=40

# ---- Internal services (docker compose overrides these) ----
# TMP_DIR=/data/tmp
# TELEGRAM_API_URL=http://bot-api:8081/
# METRICS_ADDR=0.0.0.0:9090  (set to empty to disable the /metrics endpoint)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# Refresh yt-dlp from the latest release on every container start (entrypoint
# downloads into /data/tmp/bin and falls back to the pinned binary on any
# error). Set to "false" to keep the pinned binary. Default: true
YTDLP_AUTO_UPDATE=true
