  "query": "UPDATE download_jobs\n             SET status = 'downloading', claimed_by = $1, updated_at = $2\n             WHERE id = (\n                 SELECT id FROM download_jobs\n                 WHERE status = 'queued'\n                 ORDER BY created_at\n                 FOR UPDATE SKIP LOCKED\n                 LIMIT 1\n             )\n             RETURNING id, user_id, kind, payload",
